DATABASE_URL=postgres://user:pass@localhost:5432/hookio
REDIS_URL=redis://localhost:6379
BETTER_AUTH_SECRET=your-random-32-character-secret-key
BETTER_AUTH_URL=http://localhost:5004
HOOKI_MODE=self-hosted

# Transactional email for password reset OTPs.
RESEND_API_KEY=re_xxxxxxxxx
RESEND_FROM_EMAIL="Hooki <noreply@example.com>"

# Optional self-hosted admin recovery/bootstrap.
# When HOOKI_ADMIN_EMAIL or HOOKI_ADMIN_PASSWORD is set, startup enforces it.
# HOOKI_ADMIN_EMAIL=admin@example.com
# HOOKI_ADMIN_PASSWORD=change-this-password
# HOOKI_ADMIN_NAME=Admin
